# Copy to .env and replace every CHANGE_ME.  .env is git-ignored (SEC-2).
# Generate each password with:  openssl rand -base64 24
# Never reuse the value "postgres" (SEC-9).

# --- Database connection ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=analytics_demo

# --- Superuser, used ONLY by docker-compose to bootstrap the container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_superuser

# --- Loader role: INSERT/TRUNCATE on schema raw only (SEC-5) ---
LOADER_USER=loader_rw
LOADER_PASSWORD=CHANGE_ME_loader

# --- Dashboard role: SELECT on schema analytics only (SEC-5) ---
RO_USER=dashboard_ro
RO_PASSWORD=CHANGE_ME_readonly

# --- Paths (relative to the repo root) ---
DATA_RAW_DIR=./data/raw
EXPORTS_DIR=./exports
