# Local tool config and personal working notes — not part of the software.
# The engineering documentation that IS part of it lives in docs/.
CLAUDE.md
ai-context/

# Secrets — never commit (SEC-2)
.env
.env.local
*.pem
*.key
kaggle.json

# Downloaded data — untrusted input, large, re-downloadable (see docs/DATA.md)
data/raw/*
!data/raw/.gitkeep

# Generated artefacts
exports/*
!exports/.gitkeep

# BI workbooks (may embed credentials or extracts)
*.pbix
*.twb
*.twbx
*.hyper

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
